{
  "name": "family-legal-agent",
  "version": "1.0.0",
  "description": "A family legal agent with a local workspace, shell tools, memory, task tracking, web access, and recurring schedules.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "AUTO_BLOCK_EXTERNAL_PROVIDERS=true mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "start:container": "node scripts/start-container.mjs",
    "test:legal-intake": "esbuild tests/legal-intake-scorers.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/my-mastra-legal-intake-tests.cjs && node --test /tmp/my-mastra-legal-intake-tests.cjs",
    "test:leads": "esbuild tests/legal-lead-store.test.ts --bundle --platform=node --format=esm --packages=external --outfile=.mastra/legal-lead-store-test.mjs && node --test .mastra/legal-lead-store-test.mjs",
    "test:miniapp-agent": "esbuild tests/miniapp-agent-route.test.ts --bundle --platform=node --format=esm --packages=external --outfile=.mastra/miniapp-agent-route-test.mjs && node --test .mastra/miniapp-agent-route-test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@mastra/core": "1.75.0",
    "@mastra/duckdb": "1.13.0",
    "@mastra/libsql": "1.25.1",
    "@mastra/memory": "1.36.0",
    "@mastra/mysql": "^0.12.1",
    "@mastra/observability": "1.18.4",
    "mysql2": "^3.24.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "mastra": "1.33.0",
    "typescript": "^6.0.3"
  }
}
