{
  "name": "my-mastra-app",
  "version": "1.0.0",
  "description": "A general-purpose Mastra agent with a local workspace, shell tools, memory, task tracking, web access, and recurring schedules.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "AUTO_BLOCK_EXTERNAL_PROVIDERS=true mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "test:legal-intake": "esbuild tests/legal-intake-scorers.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/my-mastra-legal-intake-tests.cjs && node --test /tmp/my-mastra-legal-intake-tests.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@mastra/core": "1.66.0",
    "@mastra/duckdb": "1.8.0",
    "@mastra/libsql": "1.22.5",
    "@mastra/memory": "1.29.0",
    "@mastra/observability": "1.17.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "mastra": "1.29.0",
    "typescript": "^6.0.3"
  }
}
