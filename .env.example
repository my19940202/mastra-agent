# 家庭法律预咨询助手使用 DeepSeek。
DEEPSEEK_API_KEY=

# 原项目自带的通用 Agent 仍使用 Google；只测试法律 Agent 时可以留空。
GOOGLE_GENERATIVE_AI_API_KEY=

# Docker / production: create a dedicated database and least-privilege app user.
# Container startup enforces MASTRA_STORAGE_BACKEND=mysql. Set this explicitly
# only when intentionally testing MySQL locally; otherwise local dev keeps SQLite.
# MASTRA_STORAGE_BACKEND=mysql
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=family_legal_agent
MYSQL_USER=mastra_app
MYSQL_PASSWORD=
MYSQL_SSL_CA=
# TLS is enabled by default. Set false only for an explicitly trusted local DB.
MYSQL_SSL=true
MYSQL_CONNECTION_LIMIT=10
